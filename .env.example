# Which provider: atria | gemini | anthropic | mock
# Leave unset and it auto-selects the first key present, in the order
# gemini -> anthropic -> atria, falling back to mock if there are none.
# LLM_PROVIDER=gemini

# OpenAI-compatible endpoint (Atria, OpenRouter, OpenAI, or any hosted gateway).
# Must support forced function calling — the attacker and the judge both need it.
ATRIA_API_KEY=
ATRIA_BASE_URL=https://api.atria-asi.ai/v1
ATRIA_MODEL=Atria-Dawn-Preview

# Google AI Studio — free tier. Get a key at https://aistudio.google.com/apikey
# (no billing card needed). Note the free tier is 20 requests/day/model, and a
# single leak test spends roughly a dozen, so this allows about one run a day.
GEMINI_API_KEY=
# Comma-separated fallback chain, tried in order. gemini-2.5-flash is closed to
# new projects, so do not put it first.
GEMINI_MODEL=gemini-3.8-flash,gemini-flash-latest

# Anthropic — only if you already have a key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Maya Research TTS (voice read-back) - https://docs.mayaresearch.ai
# Optional; without it everything works except the spoken read-back.
MAYA_API_KEY=

# Signed receipts. Optional; without a 32-byte hex/base64 seed, a demo Ed25519
# identity is generated at server boot and rotates on restart.
RECEIPT_SIGNING_SEED=

# Optional Upstash Redis REST ledger. Without it, Warrant appends locally to
# .warrant/ledger.jsonl. Supply the REST token when the endpoint requires one.
LEDGER_KV_URL=
LEDGER_KV_TOKEN=

# GitHub App PR Gate.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT NOTE — read this before putting Warrant on Vercel (or any host that
# runs the app as short-lived serverless functions).
#
# 1. A paid Vercel plan is REQUIRED for a real leak test. /api/crash and
#    /api/suite both declare `maxDuration = 300` because a run is dozens of
#    sequential paid model calls. Vercel's Hobby plan hard-caps every serverless
#    function at 60 seconds regardless of that value, so on Hobby the stream is
#    killed mid-report at 60s and the browser shows a truncated verdict. Hobby
#    can host the UI; it cannot host a full run. Use Pro/Enterprise (or run
#    `npm run dev` / `npm run build && npm start` on a box with no 60s cap).
#
# 2. RECEIPT_SIGNING_SEED is REQUIRED in production. lib/receipt.ts refuses to
#    boot without it when NODE_ENV=production, because a per-process demo key
#    would rotate on every cold start and make previously issued receipts
#    permanently unverifiable. Generate 32 random bytes, e.g.
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    and store it in the host's secret manager, not in a committed file.
#
# 3. Never commit a filled-in copy of this file. .gitignore covers .env,
#    .env.local, .env.production and .env.development; keep it that way.
# ─────────────────────────────────────────────────────────────────────────────
