# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env
# NEVER commit a real env file. `.env*.local` alone leaves a hole: a Next.js /
# Vercel production deploy reads .env.production and .env.development, which is
# exactly where a copied key ends up. Only .env.example belongs in the repo.
.env
.env.local
.env.production
.env.development
.env*.local
.env.production.local
.env.development.local
.env.test.local
!.env.example

